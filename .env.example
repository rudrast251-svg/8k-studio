# Copy this file to .env and fill in real values for production.
# Nothing here is required to run in local demo mode.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Postgres in production, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

SITE_BASE_URL=http://127.0.0.1:8000

# --- Real AI / GPU processing (Replicate) -----------------------------
# Leave blank to run in demo mode (genuine local Pillow/OpenCV processing
# instead of full neural 8K upscaling).
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=nightmareai/real-esrgan:f121d640bd286e1fdc67f9799164c1d5be36ff74576ee11c803ae5b665dd46a
REPLICATE_VIDEO_MODEL=lucataco/real-esrgan-video:c3e5a3b3e5d29ba6b9db63e9c15c7b31b8d3d1a5a6b0f9b34c1cc7b02a5c6e77
REPLICATE_WEBHOOK_SECRET=

# --- Natural-language instruction parsing (optional) -------------------
# Leave blank to use the built-in keyword parser only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Payments (optional) ------------------------------------------------
# Leave blank to run plan upgrades in demo mode (instant, no real charge).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloud storage (optional) -------------------------------------------
# Leave AWS_STORAGE_BUCKET_NAME blank to store uploads on local disk.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=8K Studio <noreply@8kstudio.app>

# --- Misc -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500

# Auto-create a superuser on first deploy if both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
